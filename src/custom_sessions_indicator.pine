Clock  i_s2Clock = input.enum(Clock.frankfurt, "", inline = "s2", group = G_SESSIONS, tooltip = TT_SESSION)
bool   i_s3On    = input.bool(true, "", inline = "s3", group = G_SESSIONS)
string i_s3Name  = input.string("London", "", inline = "s3", group = G_SESSIONS)
