// ⑪ Style
TextSize i_textSize = input.enum(TextSize.small, "Text size", group = G_STYLE)
bool     i_textAuto = input.bool(true, "Dashboard text follows the chart theme", group = G_STYLE)
color    i_textCol  = input.color(#D1D4DC, "Dashboard text colour", group = G_STYLE)
Stroke   i_lvStroke = input.enum(Stroke.solid, "Level lines", inline = "lv", group = G_STYLE)
int      i_lvWidth  = input.int(1, "", minval = 1, maxval = 4, inline = "lv", group = G_STYLE)
bool     i_tags     = input.bool(true, "Level labels", group = G_STYLE)
bool     i_tagPrice = input.bool(false, "Price in level labels", group = G_STYLE)
float    i_maxDist  = input.float(0.0, "Hide levels farther than, × ADR (0 = never)", minval = 0.0, step = 0.5, tooltip = TT_MAX_DIST, group = G_STYLE)
// Declared last on purpose: an input added in the middle would shift the saved settings of every input after it.
TagSpot  i_tagSpot  = input.enum(TagSpot.atEnd, "Level labels position", tooltip = TT_TAG_SPOT, group = G_STYLE)
bool     i_inkAuto  = input.bool(true, "Label text adapts to the chart background", tooltip = TT_INK, group = G_STYLE)

//#endregion

//#region ═════════════════════════════════════════ 4 · Environment ═══════════════════════════════════════

// @function Converts the Stroke dropdown into a line style constant.
strokeOf(Stroke s) =>
    switch s
        Stroke.dashed => line.style_dashed
        Stroke.dotted => line.style_dotted
        => line.style_solid

// @function Converts the TextSize dropdown into a size constant.
sizeOf(TextSize s) =>
    switch s
        TextSize.tiny  => size.tiny
        TextSize.small => size.small
        TextSize.large => size.large
        => size.normal

string TZ = switch i_tz
    TZ_EXCHANGE => syminfo.timezone
    TZ_UTC      => "Etc/UTC"
    TZ_CUSTOM   => i_tzCustom
    => i_tz

// @function Timezone identifier of the city a session row is written in.
zoneOf(Clock c) =>
    switch c
        Clock.sydney    => "Australia/Sydney"
        Clock.tokyo     => "Asia/Tokyo"
        Clock.hongKong  => "Asia/Hong_Kong"
        Clock.singapore => "Asia/Singapore"
        Clock.shanghai  => "Asia/Shanghai"
        Clock.mumbai    => "Asia/Kolkata"
        Clock.dubai     => "Asia/Dubai"
        Clock.frankfurt => "Europe/Berlin"
        Clock.london    => "Europe/London"
        Clock.newYork   => "America/New_York"
        Clock.chicago   => "America/Chicago"
        Clock.utc       => "Etc/UTC"
        => TZ

int    tfSec      = timeframe.in_seconds()
int    tfMs       = tfSec * 1000
bool   intradayOk = timeframe.isintraday and tfSec <= i_maxTf * 60
bool   inWindow   = i_lookback == 0 or time >= last_bar_time - i_lookback * MS_DAY
int    barEnd     = nz(time_close, time + tfMs)
int    rightEdge  = time + (i_offset + 1) * tfMs
int    prevTime   = time[1]
bool   dayRolled  = not na(prevTime) and dayofmonth(time, TZ) != dayofmonth(prevTime, TZ)
float  PIP        = syminfo.type == "forex" ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) : syminfo.mintick
string TEXT_SIZE  = sizeOf(i_textSize)
string LV_STYLE   = strokeOf(i_lvStroke)
color  DASH_TEXT  = i_textAuto ? chart.fg_color : i_textCol

// Higher-timeframe data. Highs and lows are read with a one-bar offset, so only completed periods are used;
// the open and the start time of the current period are known from its first bar, so reading them is not a look-ahead.
[dStart, dOpen, pdh, pdl, adr] = request.security(syminfo.tickerid, "D", [time, open, high[1], low[1], ta.sma(high - low, i_avgLen)[1]], lookahead = barmerge.lookahead_on)
[wStart, wOpen, pwh, pwl]      = request.security(syminfo.tickerid, "W", [time, open, high[1], low[1]], lookahead = barmerge.lookahead_on)
[mStart, mOpen, pmh, pml]      = request.security(syminfo.tickerid, "M", [time, open, high[1], low[1]], lookahead = barmerge.lookahead_on)

//#endregion

//#region ═════════════════════════════════════════ 5 · Types ═════════════════════════════════════════════

// @type  A horizontal segment with an optional text tag at its right end.
// @field seg The line.
// @field tag The label at the right end of the line.
type Marker
    line  seg
    label tag

// @type  State machine of one recurring time window. It never draws.
// @field active     The current bar is inside the window.
// @field started    The current bar is the first bar of a window.
// @field ended      The current bar is the first bar after a window.
// @field startTime  Open time of the first bar of the running window.
// @field endTime    Close time of the latest bar of the running window.
// @field openPrice  Open of the first bar of the running window.
// @field hi         Highest high of the running window.
// @field lo         Lowest low of the running window.
// @field hiTime     Open time of the bar that made the high.
// @field loTime     Open time of the bar that made the low.
// @field lastHi     High of the latest completed window.
// @field lastLo     Low of the latest completed window.
// @field lastHiTime Open time of the bar that made lastHi.
// @field lastLoTime Open time of the bar that made lastLo.
// @field lastEnd    Close time of the latest completed window.
// @field spans      Ranges (high - low) of the latest completed windows, oldest first.
// @field key        Identity of the running window: the calendar date on which it started.
type Tracker
    bool         active     = false
    bool         started    = false
    bool         ended      = false
    int          startTime  = na
    int          endTime    = na
    float        openPrice  = na
    float        hi         = na
    float        lo         = na
    int          hiTime     = na
    int          loTime     = na
    float        lastHi     = na
    float        lastLo     = na
    int          lastHiTime = na
    int          lastLoTime = na
    int          lastEnd    = na
    array<float> spans
    int          key        = na

// @type  How a family of zones (sessions or killzones) is drawn.
type ZoneView
    ZoneStyle style
    int       fillTransp
    int       bandTransp
    int       borderTransp
    int       borderWidth
    string    borderStyle
    Caption   caption
    Align     align
    bool      showOpen
    bool      showMid
    bool      captionBelow

// @type  One slot of the settings panel: a session or a killzone.
type Zone
    bool    enabled
    string  title
    string  sess
    string  tz
    int     startMin
    int     endMin
    color   col
    Tracker trk
    box     frame
    label   tag
    line    openLn
    line    midLn

// @type  A session high or low that stays on the chart until price trades through it.
type Level
    float  price
    bool   isHigh
    string title
    color  col
    int    born
    bool   live = true
    line   seg
    label  tag

// @type  A higher-timeframe period (day, week or month) with its previous high / low and its open.
type Period
    string code
    bool   showHL
    bool   showOpen
    color  hlCol
    color  openCol
    bool   visible   = false
    int    startTime = na
    float  openPrice = na
    float  prevHi    = na
    float  prevLo    = na
    float  curHi     = na
    float  curLo     = na
    bool   hiTaken   = false
    bool   loTaken   = false
    bool   hiBreak   = false
    bool   loBreak   = false
    Marker hiMk
    Marker loMk
    Marker openMk

// @type  An opening price taken at a fixed time of day.
type Anchor
    string title
    color  col
    bool   enabled
    int    startTime = na
    float  price     = na
    Marker mk

// @type  The opening range: a window, the lines extended from it and its breakout state.
type OpeningRange
    Tracker     trk
    bool        armed  = false
    bool        upDone = false
    bool        dnDone = false
    bool        upNow  = false
    bool        dnNow  = false
    box         frame
    array<line> rails

//#endregion

//#region ═════════════════════════════════════════ 6 · Helpers ═══════════════════════════════════════════

// @function Converts the Corner dropdown into a table position.
positionOf(Corner c) =>
    switch c
        Corner.topLeft      => position.top_left
        Corner.topCenter    => position.top_center
        Corner.middleLeft   => position.middle_left
        Corner.middleRight  => position.middle_right
        Corner.bottomLeft   => position.bottom_left
        Corner.bottomCenter => position.bottom_center
        Corner.bottomRight  => position.bottom_right
        => position.top_right

// @function Label style that anchors a caption above or below a zone at the chosen side.
tagStyleOf(Align a, bool below) =>
    switch a
        Align.start  => below ? label.style_label_upper_left : label.style_label_lower_left
        Align.finish => below ? label.style_label_upper_right : label.style_label_lower_right
        => below ? label.style_label_up : label.style_label_down

// @function Linear value of one sRGB channel (0 to 255), as the contrast formula needs it.
linearOf(float channel) =>
    float v = channel / 255
    v <= 0.03928 ? v / 12.92 : math.pow((v + 0.055) / 1.055, 2.4)

// @function Relative luminance of a colour: 0 is black, 1 is white. Transparency is ignored.
luminanceOf(color c) =>
    0.2126 * linearOf(color.r(c)) + 0.7152 * linearOf(color.g(c)) + 0.0722 * linearOf(color.b(c))

// @function Contrast ratio of two luminances, from 1 (the same) to 21 (black on white).
contrastOf(float a, float b) =>
    (math.max(a, b) + 0.05) / (math.min(a, b) + 0.05)

// @function Colour for text on the chart background. The given colour is moved, in steps of a tenth, towards black on
//           a light chart or towards white on a dark one until it reaches INK_CONTRAST. A colour that already
//           reads well comes back unchanged.
inkOf(color c) =>
    color ink = c
    if i_inkAuto and not na(c)
        float ground = luminanceOf(chart.bg_color)
        // Below a luminance of 0.179 white gives more contrast than black.
        float pole = ground > 0.179 ? 0 : 255
        for step = 0 to 10
            float share = step * 0.1
            ink := color.rgb(color.r(c) + (pole - color.r(c)) * share, color.g(c) + (pole - color.g(c)) * share, color.b(c) + (pole - color.b(c)) * share, color.t(c))
            if contrastOf(luminanceOf(ink), ground) >= INK_CONTRAST
                break
    ink

// @function Label style of a level label at the right end of its line.
// @param below True puts the text under the line (lows), false over it. Ignored when the text follows the line.
levelTagStyle(bool below) =>
    if i_tagSpot == TagSpot.after
        label.style_label_left
    else
        below ? label.style_label_upper_right : label.style_label_lower_right

// @function Formats a price distance in the unit chosen by the user.
// @param span The distance (high - low).
// @param base A price of the same move, used for the percentage.
fmtSpan(float span, float base) =>
    RangeUnit unit = i_unit == RangeUnit.automatic ? (syminfo.type == "forex" ? RangeUnit.pips : RangeUnit.price) : i_unit
    string result = switch unit
        RangeUnit.ticks   => str.tostring(math.round(span / syminfo.mintick)) + " t"
        RangeUnit.pips    => str.tostring(span / PIP, "0.0") + " p"
        RangeUnit.percent => str.tostring(span / base * 100, "0.00") + "%"
        => str.tostring(span, format.mintick)
    na(span) ? NO_VALUE : result

// @function Formats a duration in milliseconds as "2h 05m" or "12m".
fmtDuration(int ms) =>
    int totalMin = math.max(math.ceil(ms / 60000.0), 0)
    int hours    = math.floor(totalMin / 60.0)
    int minutes  = totalMin % 60
    hours > 0 ? str.tostring(hours) + "h " + str.tostring(minutes, "00") + "m" : str.tostring(minutes) + "m"

// @function Reads "HHMM" at a position of a session string and returns minutes since midnight.
clockMinutes(string sess, int pos) =>
    float hh = str.tonumber(str.substring(sess, pos, pos + 2))
    float mm = str.tonumber(str.substring(sess, pos + 2, pos + 4))
    int(nz(hh) * 60 + nz(mm))

// @function The next moment (after the real current time) at which the clock of a timezone shows the given minute of the day.
nextClock(int minuteOfDay, string tz) =>
    int hh       = math.floor(minuteOfDay / 60.0)
    int mm       = minuteOfDay % 60
    int nowMs    = timenow
    int laterMs  = nowMs + MS_DAY
    int today    = timestamp(tz, year(nowMs, tz), month(nowMs, tz), dayofmonth(nowMs, tz), hh, mm, 0)
    int tomorrow = timestamp(tz, year(laterMs, tz), month(laterMs, tz), dayofmonth(laterMs, tz), hh, mm, 0)
    today > nowMs ? today : tomorrow

// @function True when the real current time, read on the clock of a timezone, is inside a window given in minutes of the day.
//           Handles windows that cross midnight.
clockInside(int startMin, int endMin, string tz) =>
    int nowMin = hour(timenow, tz) * 60 + minute(timenow, tz)
    startMin < endMin ? (nowMin >= startMin and nowMin < endMin) : (nowMin >= startMin or nowMin < endMin)

// @function Identity of the run of a window that the current bar belongs to: the calendar date on which that run started.
//           Two bars of the same run get the same key; the first bar of the next run gets a new one, even when the chart
//           has no bar between the two runs (regular-hours charts, 24-hour windows).
// @param startMin Start of the window in minutes since midnight.
// @param endMin   End of the window in minutes since midnight.
// @param tz       Timezone the window is written in.
windowKey(int startMin, int endMin, string tz) =>
    int  barMin        = hour(time, tz) * 60 + minute(time, tz)
    bool startedBefore = startMin >= endMin and barMin < startMin
    int  moment        = startedBefore ? time - MS_DAY : time
    year(moment, tz) * 10000 + month(moment, tz) * 100 + dayofmonth(moment, tz)

// @function True on the bar that opens at the given time of day (or is the first bar within one bar length after it).
opensAt(int hh, int mm) =>
    int target = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), hh, mm, 0)
    not na(prevTime) and prevTime < target and time >= target and time < target + tfMs

// @function True when a level is too far from the last price to be drawn (see "Hide levels farther than").
tooFar(float price) =>
    i_maxDist > 0 and not na(adr) and math.abs(price - close) > i_maxDist * adr

// @function Appends a name to a comma-separated list.
joinName(string list, string name) =>
    list == "" ? name : list + ", " + name

//#endregion

//#region ═════════════════════════════════════════ 7 · Engine ════════════════════════════════════════════

// ── Marker ───────────────────────────────────────────────────────────────────────────────────────────────

// @function Redraws the marker from scratch. A marker with no price is erased.
// @param below True puts the label under the line instead of over it.
method place(Marker this, int x1, int x2, float y, string txt, color col, bool below) =>
    this.seg.delete()
    this.tag.delete()
    this.seg := na
    this.tag := na
    if not na(y) and not na(x1) and not tooFar(y)
        this.seg := line.new(x1, y, x2, y, xloc = xloc.bar_time, color = col, style = LV_STYLE, width = i_lvWidth)
        if i_tags
            string caption = i_tagPrice ? txt + "  " + str.tostring(y, format.mintick) : txt
            this.tag := label.new(x2, y, caption, xloc = xloc.bar_time, style = levelTagStyle(below), color = color(na), textcolor = inkOf(col), size = TEXT_SIZE)
    true

// ── Tracker ──────────────────────────────────────────────────────────────────────────────────────────────

// @function Advances the state machine by one bar.
// @param inside True when the current bar belongs to the window.
// @param key    Identity of the run the bar belongs to (see windowKey). A change of key while the window is active
//               means one run ended and the next began with no bar between them: both flags are set on that bar.
method advance(Tracker this, bool inside, int key) =>
    bool renewed = inside and this.active and key != this.key
    this.started := inside and (not this.active or renewed)
    this.ended   := this.active and (not inside or renewed)
    if this.ended
        this.lastHi     := this.hi
        this.lastLo     := this.lo
        this.lastHiTime := this.hiTime
        this.lastLoTime := this.loTime
        this.lastEnd    := this.endTime
        this.spans.push(this.hi - this.lo)
        if this.spans.size() > i_avgLen
            this.spans.shift()
    if this.started
        this.key       := key
        this.startTime := time
        this.openPrice := open
        this.hi        := high
        this.lo        := low
        this.hiTime    := time
        this.loTime    := time
    else if inside
        if high > this.hi
            this.hi     := high
            this.hiTime := time
        if low < this.lo
            this.lo     := low
            this.loTime := time
    if inside
        this.endTime := barEnd
    this.active := inside
    true

// ── Zone ─────────────────────────────────────────────────────────────────────────────────────────────────

// @function Text of the caption of a zone.
method captionOf(Zone this, ZoneView v) =>
    Tracker t = this.trk
    string span = fmtSpan(t.hi - t.lo, t.lo)
    switch v.caption
        Caption.nameOnly  => this.title
        Caption.rangeOnly => span
        => this.title + "  " + span

// @function Time coordinate of the caption of a zone.
method captionX(Zone this, ZoneView v) =>
    Tracker t = this.trk
    int middle = math.round((t.startTime + t.endTime) / 2.0)
    switch v.align
        Align.start  => t.startTime
        Align.finish => t.endTime
        => middle

// @function Creates the drawings of a zone on its first bar and stretches them on every following bar.
method draw(Zone this, ZoneView v, bool visible) =>
    Tracker t = this.trk
    bool boxed = v.style == ZoneStyle.boxed or v.style == ZoneStyle.boxedBand
    if t.started
        // The drawings of the previous window stay on the chart; the zone only lets go of them.
        this.frame  := na
        this.tag    := na
        this.openLn := na
        this.midLn  := na
        if visible
            if boxed
                this.frame := box.new(t.startTime, t.hi, t.endTime, t.lo, xloc = xloc.bar_time, border_color = color.new(this.col, v.borderTransp), border_width = v.borderWidth, border_style = v.borderStyle, bgcolor = color.new(this.col, v.fillTransp))
            if v.caption != Caption.hidden
                this.tag := label.new(this.captionX(v), v.captionBelow ? t.lo : t.hi, this.captionOf(v), xloc = xloc.bar_time, style = tagStyleOf(v.align, v.captionBelow), color = color(na), textcolor = inkOf(this.col), size = TEXT_SIZE)
            if v.showOpen
                this.openLn := line.new(t.startTime, t.openPrice, t.endTime, t.openPrice, xloc = xloc.bar_time, color = this.col, style = line.style_dotted, width = 1)
            if v.showMid
                float mid0 = (t.hi + t.lo) / 2
                this.midLn := line.new(t.startTime, mid0, t.endTime, mid0, xloc = xloc.bar_time, color = this.col, style = line.style_dashed, width = 1)
    else if t.active
        float mid = (t.hi + t.lo) / 2
        this.frame.set_top(t.hi)
        this.frame.set_bottom(t.lo)
        this.frame.set_right(t.endTime)
        this.tag.set_xy(this.captionX(v), v.captionBelow ? t.lo : t.hi)
        this.tag.set_text(this.captionOf(v))
        this.openLn.set_x2(t.endTime)
        this.midLn.set_xy1(t.startTime, mid)
        this.midLn.set_xy2(t.endTime, mid)
    true

// @function Advances and draws every zone of a family.
// @returns  [names of the zones that started on this bar, names of the zones that ended on this bar]
runZones(array<Zone> zones, ZoneView v) =>
    string startedNames = ""
    string endedNames   = ""
    for z in zones
        bool inside = z.enabled and intradayOk and not na(time(timeframe.period, z.sess, z.tz))
        z.trk.advance(inside, windowKey(z.startMin, z.endMin, z.tz))
        z.draw(v, inWindow)
        if z.trk.started
            startedNames := joinName(startedNames, z.title)
        if z.trk.ended
            endedNames := joinName(endedNames, z.title)
    [startedNames, endedNames]

// @function Background colour of one zone slot on the current bar.
bandOf(array<Zone> zones, int index, ZoneView v) =>
    Zone z = zones.get(index)
    bool banded = v.style == ZoneStyle.band or v.style == ZoneStyle.boxedBand
    banded and z.trk.active and inWindow ? color.new(z.col, v.bandTransp) : na

// ── Level ────────────────────────────────────────────────────────────────────────────────────────────────

// @function Puts a new session level on the chart and enforces the maximum number of levels.
addLevel(array<Level> levels, float price, int fromTime, bool isHigh, string title, color col) =>
    Level lv = Level.new(price, isHigh, title, col, fromTime)
    lv.seg := line.new(fromTime, price, barEnd, price, xloc = xloc.bar_time, color = col, style = LV_STYLE, width = i_lvWidth)
    if i_tags
        string caption = i_tagPrice ? title + "  " + str.tostring(price, format.mintick) : title
        lv.tag := label.new(barEnd, price, caption, xloc = xloc.bar_time, style = levelTagStyle(not isHigh), color = color(na), textcolor = inkOf(col), size = TEXT_SIZE)
    levels.push(lv)
    if levels.size() > i_lvMax
        Level oldest = levels.shift()
        oldest.seg.delete()
        oldest.tag.delete()
    true

// @function Checks every live level against the current bar and retires the ones price has traded through.
// @returns  [names of the highs broken on this bar, names of the lows broken on this bar]
updateLevels(array<Level> levels) =>
    string brokenHighs = ""
    string brokenLows  = ""
    int count = levels.size()
    if count > 0
        for i = count - 1 to 0
            Level lv = levels.get(i)
            if lv.live
                bool hit = lv.isHigh ? high > lv.price : low < lv.price
                if hit
                    lv.live := false
                    if lv.isHigh
                        brokenHighs := joinName(brokenHighs, lv.title)
                    else
                        brokenLows := joinName(brokenLows, lv.title)
                    lv.tag.delete()
                    if i_lvMode == Broken.erased
                        lv.seg.delete()
                        levels.remove(i)
                    else
                        lv.seg.set_x2(time)
                        lv.seg.set_style(line.style_dotted)
                        lv.seg.set_color(color.new(lv.col, 55))
                else if barstate.islast
                    // A level that is far from price is folded back to its first bar, so it cannot stretch the price scale.
                    int reach = tooFar(lv.price) ? lv.born : rightEdge
                    lv.seg.set_x2(reach)
                    lv.tag.set_x(reach)
    [brokenHighs, brokenLows]

// ── Period ───────────────────────────────────────────────────────────────────────────────────────────────

// @function Feeds the period with the higher-timeframe values of the current bar.
// @param pStart  Start time of the current period.
// @param pOpen   Open of the current period.
// @param pHi     High of the previous period.
// @param pLo     Low of the previous period.
// @param visible False on chart timeframes that are not lower than the period.
method feed(Period this, int pStart, float pOpen, float pHi, float pLo, bool visible) =>
    this.visible := visible
    bool rolled = not na(pStart) and (na(this.startTime) or pStart != this.startTime)
    if rolled
        if i_pHistory and inWindow and visible and not na(this.startTime)
            // Freeze the lines of the period that has just ended.
            if this.showHL and not na(this.prevHi)
                line.new(this.startTime, this.prevHi, time, this.prevHi, xloc = xloc.bar_time, color = color.new(this.hlCol, 45), style = LV_STYLE, width = i_lvWidth)
                line.new(this.startTime, this.prevLo, time, this.prevLo, xloc = xloc.bar_time, color = color.new(this.hlCol, 45), style = LV_STYLE, width = i_lvWidth)
            if this.showOpen and not na(this.openPrice)
                line.new(this.startTime, this.openPrice, time, this.openPrice, xloc = xloc.bar_time, color = color.new(this.openCol, 45), style = LV_STYLE, width = i_lvWidth)
        this.startTime := pStart
        this.openPrice := pOpen
        this.prevHi    := pHi
        this.prevLo    := pLo
        this.curHi     := high
        this.curLo     := low
        this.hiTaken   := false
        this.loTaken   := false
    else
        this.curHi := na(this.curHi) ? high : math.max(this.curHi, high)
        this.curLo := na(this.curLo) ? low : math.min(this.curLo, low)
    this.hiBreak := not this.hiTaken and not na(this.prevHi) and high > this.prevHi
    this.loBreak := not this.loTaken and not na(this.prevLo) and low < this.prevLo
    if this.hiBreak
        this.hiTaken := true
    if this.loBreak
        this.loTaken := true
    true

// @function Redraws the lines of the current period. Called on the last bar only.
method redraw(Period this) =>
    bool hl = this.visible and this.showHL
    bool op = this.visible and this.showOpen
    this.hiMk.place(this.startTime, rightEdge, hl ? this.prevHi : na, "P" + this.code + "H", this.hlCol, false)
    this.loMk.place(this.startTime, rightEdge, hl ? this.prevLo : na, "P" + this.code + "L", this.hlCol, true)
    this.openMk.place(this.startTime, rightEdge, op ? this.openPrice : na, this.code + " Open", this.openCol, false)
    true

// ── Anchor ───────────────────────────────────────────────────────────────────────────────────────────────

// @function Takes a new opening price when the trigger fires.
method capture(Anchor this, bool trigger) =>
    if this.enabled and trigger
        if i_pHistory and inWindow and not na(this.price)
            line.new(this.startTime, this.price, time, this.price, xloc = xloc.bar_time, color = color.new(this.col, 45), style = LV_STYLE, width = i_lvWidth)
        this.startTime := time
        this.price     := open
    true

// @function Redraws the line of the latest opening price. Called on the last bar only.
method refresh(Anchor this) =>
    this.mk.place(this.startTime, rightEdge, this.enabled and timeframe.isintraday ? this.price : na, this.title, this.col, false)
    true

// ── Opening range ────────────────────────────────────────────────────────────────────────────────────────

// @function Adds one extended line of the opening range.
method rail(OpeningRange this, float price, string style) =>
    this.rails.push(line.new(this.trk.lastEnd, price, barEnd, price, xloc = xloc.bar_time, color = i_orCol, style = style, width = 1))
    true

// @function Advances the opening range by one bar: measures the window, extends its lines and detects the breakout.
method run(OpeningRange this, bool inside, int key, bool visible) =>
    Tracker t = this.trk
    t.advance(inside, key)
    this.upNow := false
    this.dnNow := false
    if t.started
        this.armed  := false
        this.upDone := false
        this.dnDone := false
        this.frame  := na
        this.rails.clear()
        if visible
            this.frame := box.new(t.startTime, t.hi, t.endTime, t.lo, xloc = xloc.bar_time, border_color = color.new(i_orCol, 30), border_width = 1, bgcolor = color.new(i_orCol, 85))
    else if t.active
        this.frame.set_top(t.hi)
        this.frame.set_bottom(t.lo)
        this.frame.set_right(t.endTime)
    if t.ended
        this.armed := true
        if visible
            float span = t.lastHi - t.lastLo
            this.rail(t.lastHi, line.style_solid)
            this.rail(t.lastLo, line.style_solid)
            if i_orMid
                this.rail((t.lastHi + t.lastLo) / 2, line.style_dashed)
            if i_orProj1 > 0
                this.rail(t.lastHi + span * i_orProj1, line.style_dotted)
                this.rail(t.lastLo - span * i_orProj1, line.style_dotted)
            if i_orProj2 > 0
                this.rail(t.lastHi + span * i_orProj2, line.style_dotted)
                this.rail(t.lastLo - span * i_orProj2, line.style_dotted)
    if this.armed
        if time >= t.lastEnd + int(i_orHours * MS_HOUR)
            this.armed := false
        else
            for ln in this.rails
                ln.set_x2(barEnd)
            // A breakout is a close outside the range, confirmed at the end of the bar.
            if barstate.isconfirmed
                if not this.upDone and close > t.lastHi
                    this.upDone := true
                    this.upNow  := true
                    if visible and i_orSignals
                        label.new(time, low, "", xloc = xloc.bar_time, yloc = yloc.belowbar, color = i_orCol, style = label.style_triangleup, size = size.tiny)
                if not this.dnDone and close < t.lastLo
                    this.dnDone := true
                    this.dnNow  := true
                    if visible and i_orSignals
                        label.new(time, high, "", xloc = xloc.bar_time, yloc = yloc.abovebar, color = i_orCol, style = label.style_triangledown, size = size.tiny)
    true

//#endregion

//#region ═════════════════════════════════════════ 8 · State ═════════════════════════════════════════════

// @function A tracker with its history buffer ready.
newTracker() =>
    Tracker.new(spans = array.new<float>())

// @function A zone slot built from its inputs and the timezone its window is written in.
newZone(bool enabled, string title, string sess, string tz, color col) =>
    Zone.new(enabled, title, sess, tz, clockMinutes(sess, 0), clockMinutes(sess, 5), col, newTracker())

// @function A period with its three markers ready.
newPeriod(string code, bool showHL, bool showOpen, color hlCol, color openCol) =>
    Period.new(code, showHL, showOpen, hlCol, openCol, hiMk = Marker.new(), loMk = Marker.new(), openMk = Marker.new())

var array<Zone>  sessions  = array.new<Zone>()
var array<Zone>  killzones = array.new<Zone>()
var array<Level> levels    = array.new<Level>()

if barstate.isfirst
    sessions.push(newZone(i_s1On, i_s1Name, i_s1Time, zoneOf(i_s1Clock), i_s1Col))
    sessions.push(newZone(i_s2On, i_s2Name, i_s2Time, zoneOf(i_s2Clock), i_s2Col))
    sessions.push(newZone(i_s3On, i_s3Name, i_s3Time, zoneOf(i_s3Clock), i_s3Col))
    sessions.push(newZone(i_s4On, i_s4Name, i_s4Time, zoneOf(i_s4Clock), i_s4Col))
    sessions.push(newZone(i_s5On, i_s5Name, i_s5Time, zoneOf(i_s5Clock), i_s5Col))
    killzones.push(newZone(i_kzOn and i_k1On, i_k1Name, i_k1Time, TZ, i_k1Col))
    killzones.push(newZone(i_kzOn and i_k2On, i_k2Name, i_k2Time, TZ, i_k2Col))
    killzones.push(newZone(i_kzOn and i_k3On, i_k3Name, i_k3Time, TZ, i_k3Col))
    killzones.push(newZone(i_kzOn and i_k4On, i_k4Name, i_k4Time, TZ, i_k4Col))
    killzones.push(newZone(i_kzOn and i_k5On, i_k5Name, i_k5Time, TZ, i_k5Col))

var ZoneView sessionView  = ZoneView.new(i_sStyle, i_sFill, i_sBand, i_sBorder, i_sWidth, strokeOf(i_sStroke), i_sCaption, i_sAlign, i_sOpen, i_sMid, false)
var ZoneView killzoneView = ZoneView.new(i_kStyle, i_kFill, i_kBand, 55, 1, line.style_dotted, i_kCaption, i_kAlign, false, false, true)

var Period dayPeriod   = newPeriod("D", i_pdOn, i_doOn, i_pdCol, i_doCol)
var Period weekPeriod  = newPeriod("W", i_pwOn, i_woOn, i_pwCol, i_woCol)
var Period monthPeriod = newPeriod("M", i_pmOn, i_moOn, i_pmCol, i_moCol)

var Anchor midnightOpen = Anchor.new("00:00 Open", i_mnCol, i_mnOn, mk = Marker.new())
var Anchor customOpen   = Anchor.new(str.tostring(i_coHour, "00") + ":" + str.tostring(i_coMin, "00") + " Open", i_coCol, i_coOn, mk = Marker.new())

var OpeningRange openingRange = OpeningRange.new(newTracker(), rails = array.new<line>())

var array<string> WEEKDAYS = array.from("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")

//#endregion

//#region ═════════════════════════════════════════ 9 · Pipeline ══════════════════════════════════════════

// The engine reports events as it goes: zones that started or ended, levels that broke, range breakouts.
// Nothing consumes them on main today: the alerts module that turns them into notifications is parked on the
// feature/alerts branch, and the session VWAP that restarts at a session start on feature/vwap.

// 1. Sessions and killzones.
[sessionsStarted, sessionsEnded]   = runZones(sessions, sessionView)
[killzonesStarted, killzonesEnded] = runZones(killzones, killzoneView)

// 2. Session highs and lows that wait to be broken.
if i_lvOn and inWindow
    for z in sessions
        if z.trk.ended
            addLevel(levels, z.trk.lastHi, z.trk.lastHiTime, true, z.title + " High", z.col)
            addLevel(levels, z.trk.lastLo, z.trk.lastLoTime, false, z.title + " Low", z.col)
[brokenHighs, brokenLows] = updateLevels(levels)

// 3. Previous day / week / month and the opening prices.
dayPeriod.feed(dStart, dOpen, pdh, pdl, tfSec < timeframe.in_seconds("D"))
weekPeriod.feed(wStart, wOpen, pwh, pwl, tfSec < timeframe.in_seconds("W"))
monthPeriod.feed(mStart, mOpen, pmh, pml, tfSec < timeframe.in_seconds("M"))
midnightOpen.capture(opensAt(0, 0))
customOpen.capture(opensAt(i_coHour, i_coMin))

if barstate.islast
    dayPeriod.redraw()
    weekPeriod.redraw()
    monthPeriod.redraw()
    midnightOpen.refresh()
    customOpen.refresh()

// 4. Opening range.
bool inOpeningRange = i_orOn and intradayOk and not na(time(timeframe.period, i_orTime, TZ))
openingRange.run(inOpeningRange, windowKey(clockMinutes(i_orTime, 0), clockMinutes(i_orTime, 5), TZ), inWindow)

// 5. Time tools.
if dayRolled and inWindow and timeframe.isintraday
    if i_sepOn
        line.new(time, low, time, high + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = i_sepCol, style = line.style_dotted, width = 1)
    if i_wdOn
        label.new(time, low, WEEKDAYS.get(dayofweek(time, TZ) - 1), xloc = xloc.bar_time, yloc = yloc.belowbar, style = label.style_none, color = color(na), textcolor = color.new(chart.fg_color, 30), size = TEXT_SIZE)

//#endregion

//#region ═════════════════════════════════════════ 10 · Plots ════════════════════════════════════════════

bgcolor(bandOf(sessions, 0, sessionView), title = "Session 1 background")
bgcolor(bandOf(sessions, 1, sessionView), title = "Session 2 background")
bgcolor(bandOf(sessions, 2, sessionView), title = "Session 3 background")
bgcolor(bandOf(sessions, 3, sessionView), title = "Session 4 background")
bgcolor(bandOf(sessions, 4, sessionView), title = "Session 5 background")
bgcolor(bandOf(killzones, 0, killzoneView), title = "Killzone 1 background")
bgcolor(bandOf(killzones, 1, killzoneView), title = "Killzone 2 background")
bgcolor(bandOf(killzones, 2, killzoneView), title = "Killzone 3 background")
bgcolor(bandOf(killzones, 3, killzoneView), title = "Killzone 4 background")
bgcolor(bandOf(killzones, 4, killzoneView), title = "Killzone 5 background")

// Running high and low of every session slot, for the Data Window and for user-made alerts.
plot(sessions.get(0).trk.active ? sessions.get(0).trk.hi : na, "Session 1 high", display = display.data_window, editable = false)
plot(sessions.get(0).trk.active ? sessions.get(0).trk.lo : na, "Session 1 low", display = display.data_window, editable = false)
plot(sessions.get(1).trk.active ? sessions.get(1).trk.hi : na, "Session 2 high", display = display.data_window, editable = false)
plot(sessions.get(1).trk.active ? sessions.get(1).trk.lo : na, "Session 2 low", display = display.data_window, editable = false)
plot(sessions.get(2).trk.active ? sessions.get(2).trk.hi : na, "Session 3 high", display = display.data_window, editable = false)
plot(sessions.get(2).trk.active ? sessions.get(2).trk.lo : na, "Session 3 low", display = display.data_window, editable = false)
plot(sessions.get(3).trk.active ? sessions.get(3).trk.hi : na, "Session 4 high", display = display.data_window, editable = false)
plot(sessions.get(3).trk.active ? sessions.get(3).trk.lo : na, "Session 4 low", display = display.data_window, editable = false)
plot(sessions.get(4).trk.active ? sessions.get(4).trk.hi : na, "Session 5 high", display = display.data_window, editable = false)
plot(sessions.get(4).trk.active ? sessions.get(4).trk.lo : na, "Session 5 low", display = display.data_window, editable = false)

//#endregion

//#region ═════════════════════════════════════════ 11 · Dashboard ════════════════════════════════════════

var table dashboard = i_dashOn ? table.new(positionOf(i_dashPos), 4, 9, bgcolor = color.new(chart.bg_color, 10), frame_color = color.new(chart.fg_color, 80), frame_width = 1, border_width = 0) : na

// @function Writes one cell of the dashboard.
dashCell(int column, int row, string txt, color col, string halign) =>
    table.cell(dashboard, column, row, txt, text_color = col, text_halign = halign, text_size = sizeOf(i_dashSize))

if i_dashOn and barstate.islast
    color dim = color.new(DASH_TEXT, 45)
    dashCell(0, 0, "Custom Sessions", DASH_TEXT, text.align_left)
    table.merge_cells(dashboard, 0, 0, 3, 0)
    dashCell(0, 1, "Session", dim, text.align_left)
    dashCell(1, 1, "Status", dim, text.align_left)
    dashCell(2, 1, "Range", dim, text.align_right)
    dashCell(3, 1, "Avg " + str.tostring(i_avgLen), dim, text.align_right)
    int row = 2
    for z in sessions
        if z.enabled
            Tracker t     = z.trk
            bool isOpen   = clockInside(z.startMin, z.endMin, z.tz)
            string status = isOpen ? "Open · " + fmtDuration(nextClock(z.endMin, z.tz) - timenow) + " left" : "Opens in " + fmtDuration(nextClock(z.startMin, z.tz) - timenow)
            float span    = t.active ? t.hi - t.lo : t.lastHi - t.lastLo
            float base    = t.active ? t.lo : t.lastLo
            dashCell(0, row, "● " + z.title, inkOf(z.col), text.align_left)
            dashCell(1, row, status, isOpen ? DASH_TEXT : dim, text.align_left)
            dashCell(2, row, fmtSpan(span, base), DASH_TEXT, text.align_right)
            dashCell(3, row, fmtSpan(t.spans.avg(), base), dim, text.align_right)
            row += 1
    if i_dashDay
        float daySpan = dayPeriod.curHi - dayPeriod.curLo
        string share  = na(adr) or na(daySpan) or adr == 0 ? NO_VALUE : str.tostring(daySpan / adr * 100, "0") + "% of ADR"
        dashCell(0, row, "Day", DASH_TEXT, text.align_left)
        dashCell(1, row, share, dim, text.align_left)
        dashCell(2, row, fmtSpan(daySpan, dayPeriod.curLo), DASH_TEXT, text.align_right)
        dashCell(3, row, fmtSpan(adr, dayPeriod.curLo), dim, text.align_right)

//#endregion
