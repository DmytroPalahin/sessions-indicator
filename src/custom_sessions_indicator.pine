bool   i_s4On    = input.bool(true, "", inline = "s4", group = G_SESSIONS)
string i_s4Name  = input.string("New York", "", inline = "s4", group = G_SESSIONS)
string i_s4Time  = input.session("0800-1600", "", inline = "s4", group = G_SESSIONS)
Clock  i_s4Clock = input.enum(Clock.newYork, "", inline = "s4", group = G_SESSIONS, tooltip = TT_SESSION)
bool   i_s5On    = input.bool(false, "", inline = "s5", group = G_SESSIONS)
string i_s5Name  = input.string("Sydney", "", inline = "s5", group = G_SESSIONS)
string i_s5Time  = input.session("0800-1600", "", inline = "s5", group = G_SESSIONS)
Clock  i_s5Clock = input.enum(Clock.sydney, "", inline = "s5", group = G_SESSIONS, tooltip = TT_SESSION)
// The colours sit on a row of their own: a fifth control does not fit into a session row of the settings dialog.
color  i_s1Col   = input.color(#2962FF, "Colours", inline = "sc", group = G_SESSIONS)
