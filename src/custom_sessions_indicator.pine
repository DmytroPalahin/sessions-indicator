//@version=6
indicator("Custom Sessions Indicator", "Sessions", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
//  Custom Sessions Indicator
//  Sessions, killzones, liquidity levels, opening prices, opening range and a dashboard in one overlay.
//
//  Source, documentation and issue tracker: https://github.com/DmytroPalahin/sessions-indicator
//
//  File layout (see docs/ARCHITECTURE.md for the reasoning):
//    1 · Constants      compile-time values, group names, tooltips
//    2 · Enums          every dropdown of the settings panel
//    3 · Inputs         the settings panel, one group per module
//    4 · Environment    values derived once per bar from the chart and the inputs
//    5 · Types          state containers (no logic)
//    6 · Helpers        pure functions: conversion and formatting
//    7 · Engine         methods that advance state and draw
//    8 · State          the long-lived objects of the script
//    9 · Pipeline       the per-bar orchestration, top to bottom
//   10 · Plots          bgcolor / plot calls (must live in the global scope)
//   11 · Dashboard      the table, rendered on the last bar only
//
//  Design rules:
//    · State and drawing are separated: a Tracker never draws, a view never decides.
//    · Nothing is drawn on a bar that is older than the "History" input.
//    · Live levels are redrawn on the last bar, so the 500-object limit can never delete them.
//    · No value from the future is used: higher-timeframe data is read with a one-bar offset.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

//#region ═════════════════════════════════════════ 1 · Constants ═════════════════════════════════════════

const string VERSION   = "3.0.0"
const int    MS_MINUTE = 60000
const int    MS_HOUR   = 3600000
const int    MS_DAY    = 86400000
const string NO_VALUE  = "—"
// Contrast that label text must reach against the chart background (WCAG AA for normal text).
const float  INK_CONTRAST = 4.5

const string TZ_EXCHANGE = "Exchange"
const string TZ_UTC      = "UTC"
const string TZ_CUSTOM   = "Custom"

const string G_GENERAL  = "① General"
const string G_SESSIONS = "② Sessions · each row in the local time of its city"
const string G_SVIEW    = "③ Session display"
const string G_LEVELS   = "④ Session high / low levels"
const string G_KZ       = "⑤ Killzones · times in the timezone set in ① General"
const string G_PERIODS  = "⑥ Previous day / week / month"
const string G_OPENS    = "⑦ Opening prices"
const string G_OR       = "⑧ Opening range"
const string G_TIME     = "⑨ Time tools"
const string G_DASH     = "⑩ Dashboard"
const string G_STYLE    = "⑪ Style"

const string TT_TZ       = "The timezone of every time that is not a session row: killzones, the opening range window, the midnight and custom opens and the day labels. Sessions do not use it - each session row has its own city - unless a row is set to 'As in ①'. It is not your own timezone and it does not change the chart clock. Named zones follow daylight saving time automatically; 'Exchange' follows the symbol."
const string TT_TZ_CUST  = "Used only when 'Killzones and opens timezone' is set to 'Custom'; otherwise this field is ignored. Accepts an IANA name (Europe/London, Asia/Tokyo) or an offset (UTC+3). A name follows daylight saving time, an offset does not."
const string TT_LOOKBACK = "Drawings older than this many days are skipped. 0 draws the whole loaded history (TradingView still keeps only the newest 500 objects of each kind)."
const string TT_MAX_TF   = "Sessions, killzones and the opening range are hidden on chart timeframes above this many minutes, where they stop being meaningful."
const string TT_OFFSET   = "How many bars to the right of the last bar the level lines end. Their labels sit at that end."
const string TT_SESSION  = "Checkbox · name · hours · city. The hours are the local time of that city: London 08:00 - 16:00 is 8 to 16 o'clock in London, whatever your own timezone is, and it follows London's daylight saving time. The chart draws the session on its own clock. 'As in ①' reads the hours in the timezone set in ① General. Hours may cross midnight (1900-0400)."
const string TT_S_COLS   = "Colours of the five rows above, in the same order."
const string TT_SLOT     = "Checkbox · name · time window · colour. The window is written in the timezone set in ① General (New York by default), not in your own; the chart draws it on its own clock. A window may cross midnight (1900-0400)."
const string TT_UNIT     = "Unit of every range shown in labels and in the dashboard. 'Auto' uses pips on forex and price elsewhere."
const string TT_LEVELS   = "When a session ends, its high and low stay on the chart as lines until price trades through them."
const string TT_LV_MAX   = "The oldest level is removed when this number is exceeded."
const string TT_HISTORY  = "Keeps the lines of past days, weeks and months instead of showing only the current ones."
const string TT_CUSTOM_O = "Opening price of the bar that starts at this time of day, in the timezone set in ① General."
const string TT_OR_TIME  = "The window in which the opening range is measured, written in the timezone set in ① General."
const string TT_OR_EXT   = "How long the range lines keep extending after the window closes."
const string TT_OR_PROJ  = "Projection of the range above its high and below its low, as a multiple of the range. 0 turns a projection off."
const string TT_AVG      = "Number of completed sessions (and days) used for the 'Avg' column."
const string TT_MAX_DIST = "TradingView fits every level of an indicator into the price scale, so a level far from price squeezes the candles. Levels farther from the last price than this many average daily ranges are not drawn. 0 draws all of them."
const string TT_TAG_SPOT = "'At the line end' prints the text over the right end of the line (under it for lows), inside the chart, where the price scale cannot cut it off. 'After the line' prints it to the right of the line and needs a right margin wide enough for the text."
const string TT_INK      = "A label takes the colour of its line or zone. When this is on, a colour that would be hard to read on the chart background is darkened on a light chart and lightened on a dark one, for the text only. Lines and zones keep their colour."

//#endregion

//#region ═════════════════════════════════════════ 2 · Enums ═════════════════════════════════════════════

enum ZoneStyle
    boxed     = "Box"
    band      = "Background"
    boxedBand = "Box + background"
    hidden    = "Hidden"

enum Caption
    nameRange = "Name + range"
    nameOnly  = "Name"
    rangeOnly = "Range"
    hidden    = "Hidden"

enum Align
    start  = "Left"
    middle = "Center"
    finish = "Right"

enum RangeUnit
    automatic = "Auto"
    price     = "Price"
    ticks     = "Ticks"
    pips      = "Pips"
    percent   = "Percent"

enum Stroke
    solid  = "Solid"
    dashed = "Dashed"
    dotted = "Dotted"

enum TextSize
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"

enum Corner
    topLeft      = "Top left"
    topCenter    = "Top center"
    topRight     = "Top right"
    middleLeft   = "Middle left"
    middleRight  = "Middle right"
    bottomLeft   = "Bottom left"
    bottomCenter = "Bottom center"
    bottomRight  = "Bottom right"

enum Broken
    faded  = "Keep, faded"
    erased = "Remove"

enum TagSpot
    atEnd = "At the line end"
    after = "After the line"

// The city whose local time a session row is written in. 'general' hands the row over to the timezone of ① General.
enum Clock
    sydney    = "Sydney"
    tokyo     = "Tokyo"
    hongKong  = "Hong Kong"
    singapore = "Singapore"
    shanghai  = "Shanghai"
    mumbai    = "Mumbai"
    dubai     = "Dubai"
    frankfurt = "Frankfurt"
    london    = "London"
    newYork   = "New York"
    chicago   = "Chicago"
    utc       = "UTC"
    general   = "As in ①"

//#endregion

//#region ═════════════════════════════════════════ 3 · Inputs ════════════════════════════════════════════

// ① General
int    i_lookback = input.int(20, "History, days (0 = all)", minval = 0, tooltip = TT_LOOKBACK, group = G_GENERAL)
int    i_maxTf    = input.int(60, "Hide sessions above, minutes", minval = 1, maxval = 1440, tooltip = TT_MAX_TF, group = G_GENERAL)
int    i_offset   = input.int(5, "Level labels offset, bars", minval = 0, maxval = 200, tooltip = TT_OFFSET, group = G_GENERAL)
// The session rows of ② do not read this timezone: each of them has a city of its own.
string i_tz       = input.string("America/New_York", "Killzones and opens timezone", options = [TZ_EXCHANGE, TZ_UTC, "America/New_York", "America/Chicago", "America/Los_Angeles", "America/Sao_Paulo", "Europe/London", "Europe/Berlin", "Europe/Athens", "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Hong_Kong", "Asia/Singapore", "Asia/Tokyo", "Asia/Seoul", "Australia/Sydney", "Pacific/Auckland", TZ_CUSTOM], tooltip = TT_TZ, group = G_GENERAL)
